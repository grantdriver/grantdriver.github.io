# ---------------------------------------------------------------- main
def outname(it):
    s = it["orig"].stem if it["orig"].suffix == ".md" else it["src"].stem
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", s)
    d = it["date"]
    if d and not s.startswith(d): s = f"{d}-{s}"
    ext = it["src"].suffix.lower()
    return s + ext

def thumb_pdf(src, dest_base, w, h, crop):
    if crop:
        subprocess.run(["pdftoppm", "-jpeg", "-jpegopt", "quality=78", "-r", "30", "-f", "1", "-l", "1", "-scale-to-x", str(w), "-scale-to-y", str(h),
                        "-singlefile", str(src), str(dest_base)], check=True)
    else:
        subprocess.run(["pdftoppm", "-jpeg", "-jpegopt", "quality=75", "-f", "1", "-l", "1", "-scale-to-x", str(w), "-scale-to-y", "-1",
                        "-singlefile", str(src), str(dest_base)], check=True)

def main():
    items, games, skipped = collect()
    shutil.rmtree(SITE / "inclusion", ignore_errors=True)   # rebuilt below only for approved (or previewed) courses
    for sub in ("decks", "games", "thumbs", "plans", "printables", "teacher", "resources"):
        shutil.rmtree(SITE / sub, ignore_errors=True); (SITE / sub).mkdir(parents=True)
    for f in SITE.glob("*.html"): f.unlink()
    shutil.rmtree(SITE / "files", ignore_errors=True)
    used = set()
    DIR = {"deck": "decks", "plan": "plans", "simple": "plans", "printable": "printables", "key": "teacher"}
    from PIL import Image
    for it in items:
        sub = DIR.get(it["kind"], "resources")
        fn = outname(it)
        while (sub, fn) in used: fn = "x-" + fn
        used.add((sub, fn))
        it["ext"] = it["src"].suffix.lstrip(".").lower()
        shutil.copy2(it["src"], SITE / sub / fn)
        it["file"] = fn; it["out"] = SITE / sub / fn; it["href"] = f"{sub}/{fn}"
        tb = Path(fn).stem + ".jpg"; it["thumbhref"] = f"thumbs/{tb}"
        if it["ext"] == "pdf":
            thumb_pdf(it["src"], SITE / "thumbs" / Path(tb).stem, 320 if it["kind"] == "deck" else 192, 180 if it["kind"] == "deck" else 0, it["kind"] == "deck")
        else:
            im = Image.open(it["src"]).convert("RGB"); im.thumbnail((192, 248)); im.save(SITE / "thumbs" / tb, quality=75)
        if it["kind"] == "deck":
            it["thumb"] = tb
    decks = [i for i in items if i["kind"] == "deck"]
    non_deck = items
    hide = "<style>#teachBtn,#teacher{display:none!important}</style>"
    for g in games:
        t = g["src"].read_text(encoding="utf-8").replace("</head>", hide + "\n</head>", 1)
        (SITE / "games" / g["src"].name).write_text(t, encoding="utf-8")
    vt = video_titles(); videos = []; seen_v = set()
    for d in sorted(decks, key=lambda d: d["date"]):
        for u in d.get("urls", []):
            for c in d["classes"]:
                if (u, c) in seen_v: continue
                seen_v.add((u, c))
                videos.append(dict(url=u, title=vt.get(u, "Lesson video"), class_slug=c, date=d["date"], deck=d["title"]))
    for it in []:   # (build-ahead plans are not published)
        if it.get("draft") and it["kind"] == "plan":
            for m in re.finditer(r"\[([^\]]+)\]\((https://www\.youtube\.com/watch\?v=[\w-]+)", it["orig"].read_text(errors="ignore")):
                u = m.group(2)
                if (u, it["classes"][0]) in seen_v: continue
                seen_v.add((u, it["classes"][0]))
                videos.append(dict(url=u, title=re.sub(r"\s*\(for students.*?\)", "", m.group(1)).strip(), class_slug=it["classes"][0], date=it["date"], deck="Coming up: " + it["title"]))
    incl, incl_skipped = collect_inclusion(preview="--preview-inclusion" in sys.argv)
    NAV_INCL[:] = [(c["slug"], c.get("nav", c["name"]), c["emoji"]) for c in incl]
    NAV_TINT.clear(); NAV_TINT.update({c["slug"]: f' style="background:{c["theme"]["blue"]}"' for c in incl if (c.get("theme") or {}).get("blue")})
    skipped += incl_skipped
    build_inclusion(incl)
    build_pages(decks, items, games, videos, incl)
    build_teacher_page(items, incl)
    (SITE / "filter.js").write_text(FILTER_JS, encoding="utf-8")
    (SITE / "style.css").write_text((SCHOOL / "templates" / "style-base.css").read_text() + CSS_ADD + INCL_CSS)
    for k, why in INTERNAL_SKIP.items():
        if (SCHOOL / k).exists(): skipped.append((k, why))
    for d, why in (("team-ideas", "internal team ideas folder"), ("data", "internal data folder (only the SEL check-in how-to is published)"),
                   ("plans/ahead", "build-ahead drafts (Unit 2 plans and keys, goal-setting drafts)"), ("portfolio/covers", "cover option / old-cover design files"),
                   ("templates", "build scripts"), ("curriculum-build", "build scripts")):
        if (SCHOOL / d).exists(): skipped.append((d + "/", why))
    # ---- private report
    kinds = {}
    for it in items: kinds.setdefault(it["kind"], []).append(it)
    L = [f"# Site report ({datetime.datetime.now():%Y-%m-%d %H:%M})", "", "## Counts (files published)"]
    for k, v in sorted(kinds.items()): L.append(f"- {k}: {len(v)}")
    L.append(f"- games: {len(games)}"); L.append(f"- videos linked: {len(videos)}"); L.append("")
    L.append("## Per class page (items shown)")
    for slug, n, *_ in CLASSES:
        c = lambda k: len([i for i in items if i['kind'] in k and slug in i['classes']])
        L.append(f"- {n}: slides {c(('deck',))}, lesson plans {c(('plan','simple'))}, printables {c(('printable',))}, teacher {c(('key',))}, games {len([g for g in games if g['class_slug']==slug])}, videos {len([v for v in videos if v['class_slug']==slug])}")
    L += ["", "## Class pages by unit (lessons / slide decks / games)"]
    for slug, st in CLASS_STATS.items():
        L.append(f"- {CLASSNAME[slug]}: " + "; ".join(f"{u} {a}/{b}/{c}" for u, a, b, c in st))
    L += ["", "## Not placed in a unit (shown in Other / extras)"] + ([f"- {CLASSNAME[s_]}: {t} ({r})" for s_, t, r in UNPLACED] or ["- none"])
    L += ["", "## Published files"]
    for it in sorted(items, key=lambda i: (i["kind"], i["date"] or "", i["title"])):
        L.append(f"- [{it['kind']}] {it['date'] or '-'} · {it['title']} · {','.join(it['classes']) or 'all/general'} <- {it['rel']}")
    for c in incl:
        L.append(f"- inclusion {c['slug']}{' (PREVIEW, not approved)' if c.get('preview') else ''}: " + ", ".join(f"unit {u['n']} {len(u['items'])} files" for u in c['units'] if u['items']))
    L += ["", "## Games"] + [f"- {g['class_slug']} · {g['title']} <- {g['src'].name}" for g in games]
    L += ["", "## Videos"] + [f"- {v['class_slug']} · {v['title']} · {v['url']}" for v in videos]
    L += ["", "## Skipped (not published)"] + [f"- {a}: {b}" for a, b in skipped]
    REPORT.write_text("\n".join(L) + "\n")
    print(f"Site rebuilt: {len(decks)} decks, {len(items)-len(decks)} other files, {len(games)} games, {len(videos)} videos, {len(skipped)} skipped. Report: {REPORT}")
    for a, b in skipped:
        pass
    if "--zip" in sys.argv:
        ZIP.unlink(missing_ok=True)
        with zipfile.ZipFile(ZIP, "w", zipfile.ZIP_DEFLATED) as z:
            for f in sorted(SITE.rglob("*")):
                if f.is_file() and f.name != "update_site.py" and "__pycache__" not in f.parts:
                    z.write(f, f.relative_to(SITE))
        print("Zip:", ZIP)

if __name__ == "__main__":
    main()
